{
  "name": "Abstimmung",
  "type": "object",
  "properties": {
    "termin_id": {
      "type": "string",
      "description": "Optionale Verkn\u00fcpfung mit Sitzung (leer = unabh\u00e4ngige Abstimmung)"
    },
    "top_id": {
      "type": "string",
      "description": "Optionale Verkn\u00fcpfung mit Tagesordnungspunkt"
    },
    "titel": {
      "type": "string"
    },
    "beschreibung": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Offen",
        "Abgeschlossen"
      ],
      "default": "Offen"
    },
    "ergebnis": {
      "type": "string",
      "enum": [
        "Angenommen",
        "Abgelehnt",
        "Vertagt",
        "Enthaltung"
      ],
      "description": "Finales Ergebnis"
    },
    "angenommen_ab": {
      "type": "number",
      "description": "Ben\u00f6tigte Ja-Stimmen in % f\u00fcr Annahme",
      "default": 50
    },
    "antwort_optionen": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Vorgegebene Antwortoptionen (leer = Standard Ja/Nein/Enthaltung)"
    },
    "beschluss_id": {
      "type": "string",
      "description": "ID des aus dieser Abstimmung erzeugten Beschlusses"
    },
    "dateien": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "typ": {
            "type": "string"
          },
          "groesse": {
            "type": "number"
          },
          "datum": {
            "type": "string",
            "format": "date-time"
          },
          "hochgeladen_von_id": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "titel"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        },
        {
          "user_condition": {
            "role": "stellv_vorstand"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
