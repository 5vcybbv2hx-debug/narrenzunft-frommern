{
  "name": "AbstimmungsStimme",
  "type": "object",
  "properties": {
    "abstimmung_id": {
      "type": "string"
    },
    "mitglied_id": {
      "type": "string"
    },
    "stimme": {
      "type": "string",
      "enum": [
        "Ja",
        "Nein",
        "Enthaltung"
      ],
      "default": "Enthaltung"
    }
  },
  "required": [
    "abstimmung_id",
    "mitglied_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}