{
  "name": "AppEinstellung",
  "type": "object",
  "properties": {
    "schluessel": {
      "type": "string",
      "description": "Eindeutiger Schl\u00fcssel der Einstellung (z.B. 'busverantwortliche')"
    },
    "wert_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Liste von IDs (z.B. Mitglied-IDs)"
    },
    "wert_json": {
      "type": "object",
      "description": "Beliebige JSON-Daten (z.B. Beitragss\u00e4tze)"
    }
  },
  "description": {
    "type": "string",
    "description": "Zus\u00e4tzliche Beschreibung (bis 1000 Zeichen)",
    "maxLength": 1000
  },
  "required": [
    "schluessel"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        }
      ]
    }
  }
}