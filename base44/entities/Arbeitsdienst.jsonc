{
  "name": "Arbeitsdienst",
  "type": "object",
  "properties": {
    "titel": {
      "type": "string"
    },
    "datum": {
      "type": "string",
      "format": "date"
    },
    "uhrzeit": {
      "type": "string"
    },
    "ort": {
      "type": "string"
    },
    "beschreibung": {
      "type": "string"
    },
    "benoetigte_personen": {
      "type": "number"
    },
    "verantwortlicher_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Offen",
        "In Planung",
        "Abgeschlossen"
      ],
      "default": "Offen"
    },
    "veranstaltung_id": {
      "type": "string",
      "description": "Optionale Verkn\u00fcpfung mit einer Veranstaltung"
    },
    "push_erinnerung_id": {
      "type": "string",
      "description": "OneSignal-Notification-ID der geplanten 2h-Erinnerung (zum Ersetzen/Stornieren)"
    },
    "abfrage_frist": {
      "type": "string",
      "format": "date",
      "description": "Frist der Arbeitsdienst-Abfrage (Ja/Vielleicht/Nein); leer = keine Abfrage"
    }
  },
  "description": {
    "type": "string",
    "description": "Zus\u00e4tzliche Beschreibung (bis 1000 Zeichen)",
    "maxLength": 1000
  },
  "required": [
    "titel",
    "datum"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        },
        {
          "user_condition": {
            "role": "spartenleiter"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        },
        {
          "user_condition": {
            "role": "spartenleiter"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        }
      ]
    }
  }
}