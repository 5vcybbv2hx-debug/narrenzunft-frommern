{
  "name": "ArbeitsdienstZuweisung",
  "type": "object",
  "properties": {
    "arbeitsdienst_id": {
      "type": "string"
    },
    "mitglied_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Offen",
        "Best\u00e4tigt",
        "Abgesagt",
        "Erledigt",
        "Nicht erledigt"
      ],
      "default": "Offen"
    },
    "notizen": {
      "type": "string"
    }
  },
  "required": [
    "arbeitsdienst_id",
    "mitglied_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        },
        {
          "user_condition": {
            "role": "spartenleiter"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
