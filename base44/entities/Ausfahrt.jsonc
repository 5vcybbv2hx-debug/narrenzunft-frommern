{
  "name": "Ausfahrt",
  "type": "object",
  "properties": {
    "titel": {
      "type": "string"
    },
    "typ": {
      "type": "string",
      "enum": [
        "Umzug",
        "Veranstaltung"
      ],
      "description": "Art der Ausfahrt"
    },
    "datum": {
      "type": "string",
      "format": "date"
    },
    "ort": {
      "type": "string"
    },
    "abfahrt_zeit": {
      "type": "string",
      "description": "HH:MM"
    },
    "abfahrt_ort": {
      "type": "string",
      "default": "Schulhof Frommern"
    },
    "veranstaltungsbeginn": {
      "type": "string",
      "description": "HH:MM"
    },
    "rueckfahrt_zeit": {
      "type": "string",
      "description": "HH:MM"
    },
    "aufstellung": {
      "type": "string"
    },
    "startnummer": {
      "type": "string"
    },
    "busparkplatz": {
      "type": "string"
    },
    "bus_kapazitaet": {
      "type": "number"
    },
    "bus_verantwortliche": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs der Mitglieder, die als Busverantwortliche den QR-Check-in durchf\u00fchren d\u00fcrfen"
    },
    "sparte_auftritt": {
      "type": "boolean",
      "default": false
    },
    "sparte_id": {
      "type": "string"
    },
    "verantworlicher_id": {
      "type": "string"
    },
    "anmeldung_start": {
      "type": "string",
      "format": "date"
    },
    "anmeldung_ende": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "Geplant",
        "Anmeldung offen",
        "Anmeldung geschlossen",
        "Abgeschlossen",
        "Abgesagt"
      ],
      "default": "Geplant"
    },
    "u18_begleitung_erforderlich": {
      "type": "boolean",
      "default": false,
      "description": "true = f\u00fcr U18-T\u00e4nzer:innen ist eine begleitete Teilnahme n\u00f6tig (getrennte Eltern-/Begleitbest\u00e4tigung)"
    },
    "notizen": {
      "type": "string"
    }
  },
  "description": {
    "type": "string",
    "description": "Zus\u00e4tzliche Beschreibung (bis 1000 Zeichen)",
    "maxLength": 1000
  },
  "required": [
    "titel",
    "typ",
    "datum",
    "ort"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        },
        {
          "user_condition": {
            "role": "spartenleiter"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        },
        {
          "user_condition": {
            "role": "spartenleiter"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        }
      ]
    }
  }
}