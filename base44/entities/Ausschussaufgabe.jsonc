{
  "name": "Ausschussaufgabe",
  "type": "object",
  "properties": {
    "titel": {
      "type": "string"
    },
    "beschreibung": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Offen",
        "In Bearbeitung",
        "Erledigt",
        "Abgebrochen"
      ],
      "default": "Offen"
    },
    "prioritaet": {
      "type": "string",
      "enum": [
        "Niedrig",
        "Mittel",
        "Hoch",
        "Dringend"
      ],
      "default": "Mittel"
    },
    "faellig_am": {
      "type": "string",
      "format": "date"
    },
    "verantwortlicher_id": {
      "type": "string"
    },
    "termin_id": {
      "type": "string",
      "description": "Verkn\u00fcpfung mit Sitzung"
    },
    "notizen": {
      "type": "string"
    }
  },
  "required": [
    "titel"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        },
        {
          "user_condition": {
            "role": "spartenleiter"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        },
        {
          "user_condition": {
            "role": "spartenleiter"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        }
      ]
    }
  }
}