{
  "name": "Ausschussaufgabe",
  "type": "object",
  "properties": {
    "titel": {
      "type": "string"
    },
    "beschreibung": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Offen",
        "In Bearbeitung",
        "Wartet",
        "Erledigt",
        "Abgebrochen"
      ],
      "default": "Offen"
    },
    "prioritaet": {
      "type": "string",
      "enum": [
        "Niedrig",
        "Mittel",
        "Hoch",
        "Dringend"
      ],
      "default": "Mittel"
    },
    "faellig_am": {
      "type": "string",
      "format": "date"
    },
    "verantwortlicher_id": {
      "type": "string"
    },
    "termin_id": {
      "type": "string",
      "description": "Verkn\u00fcpfung mit Sitzung"
    },
    "notizen": {
      "type": "string"
    },
    "top_id": {
      "type": "string",
      "description": "Verkn\u00fcpfter Tagesordnungspunkt"
    },
    "beschluss_id": {
      "type": "string",
      "description": "Verkn\u00fcpfter Beschluss"
    },
    "veranstaltung_id": {
      "type": "string",
      "description": "Verkn\u00fcpfte Veranstaltung"
    },
    "quell_aufgabe_id": {
      "type": "string",
      "description": "Bei wiederkehrenden Aufgaben: ID der Vorlage/Aufgabe"
    },
    "fortschritt_notiz": {
      "type": "string",
      "description": "Aktuelle Fortschrittsnotiz"
    },
    "abgeschlossen_am": {
      "type": "string",
      "format": "date"
    },
    "wiederholung": {
      "type": "string",
      "description": "Wiederholungsregel (z.B. J\u00e4hrlich)"
    },
    "dateien": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "typ": {
            "type": "string"
          },
          "groesse": {
            "type": "number"
          },
          "datum": {
            "type": "string",
            "format": "date-time"
          },
          "hochgeladen_von_id": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "titel"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        },
        {
          "user_condition": {
            "role": "spartenleiter"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        },
        {
          "user_condition": {
            "role": "spartenleiter"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        }
      ]
    }
  }
}