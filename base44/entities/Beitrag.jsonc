{
  "name": "Beitrag",
  "type": "object",
  "properties": {
    "mitglied_id": {
      "type": "string"
    },
    "jahr": {
      "type": "number"
    },
    "betrag": {
      "type": "number"
    },
    "mitgliedsstatus": {
      "type": "string"
    },
    "zahlungsstatus": {
      "type": "string",
      "enum": [
        "Offen",
        "Bezahlt",
        "\u00dcberf\u00e4llig",
        "Erlassen"
      ],
      "default": "Offen"
    },
    "zahlungsdatum": {
      "type": "string",
      "format": "date"
    },
    "notizen": {
      "type": "string"
    }
  },
  "required": [
    "mitglied_id",
    "jahr",
    "betrag"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        },
        {
          "user_condition": {
            "role": "stellv_vorstand"
          }
        },
        {
          "user_condition": {
            "role": "kassierer"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        },
        {
          "user_condition": {
            "role": "stellv_vorstand"
          }
        },
        {
          "user_condition": {
            "role": "kassierer"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        },
        {
          "user_condition": {
            "role": "stellv_vorstand"
          }
        },
        {
          "user_condition": {
            "role": "kassierer"
          }
        }
      ]
    }
  }
}