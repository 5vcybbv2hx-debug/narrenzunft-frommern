{
  "name": "Beschluss",
  "type": "object",
  "properties": {
    "titel": {
      "type": "string"
    },
    "inhalt": {
      "type": "string"
    },
    "datum": {
      "type": "string",
      "format": "date"
    },
    "termin_id": {
      "type": "string",
      "description": "Sitzungs-ID"
    },
    "status": {
      "type": "string",
      "enum": [
        "Offen",
        "Umgesetzt",
        "Verworfen"
      ],
      "default": "Offen"
    },
    "vertraulich": {
      "type": "boolean",
      "default": false
    },
    "notizen": {
      "type": "string"
    }
  },
  "required": [
    "titel",
    "datum"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        },
        {
          "user_condition": {
            "role": "stellv_vorstand"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        },
        {
          "user_condition": {
            "role": "stellv_vorstand"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        },
        {
          "user_condition": {
            "role": "stellv_vorstand"
          }
        }
      ]
    }
  }
}