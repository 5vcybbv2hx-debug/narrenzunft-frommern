{
  "name": "Bestellrunde",
  "type": "object",
  "properties": {
    "titel": {
      "type": "string",
      "description": "Titel der Bestellrunde (z.B. 'Becher-Bestellung 2026')"
    },
    "frist_datum": {
      "type": "string",
      "format": "date",
      "description": "Bestellfrist (YYYY-MM-DD)"
    },
    "status": {
      "type": "string",
      "enum": [
        "Offen",
        "Geschlossen",
        "Bestellt"
      ],
      "default": "Offen"
    },
    "notiz": {
      "type": "string",
      "description": "Anmerkung zur Bestellrunde"
    }
  },
  "required": [
    "titel"
  ]
}