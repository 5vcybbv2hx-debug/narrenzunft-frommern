{
  "name": "Bestellrunde",
  "type": "object",
  "properties": {
    "titel": {
      "type": "string",
      "description": "Titel der Bestellrunde (z.B. 'Becher-Bestellung 2026')"
    },
    "frist_datum": {
      "type": "string",
      "format": "date",
      "description": "Bestellfrist (YYYY-MM-DD)"
    },
    "status": {
      "type": "string",
      "enum": [
        "Offen",
        "Geschlossen",
        "Bestellt"
      ],
      "default": "Offen"
    },
    "notiz": {
      "type": "string",
      "description": "Anmerkung zur Bestellrunde"
    }
  },
  "required": [
    "titel"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        }
      ]
    }
  }
}