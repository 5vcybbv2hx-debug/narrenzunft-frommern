{
  "name": "Buskostenbeitrag",
  "type": "object",
  "properties": {
    "veranstaltung_id": {
      "type": "string",
      "description": "ID der Veranstaltung"
    },
    "mitglied_id": {
      "type": "string",
      "description": "ID des Mitglieds"
    },
    "betrag": {
      "type": "number",
      "description": "Pauschalbetrag in Euro"
    },
    "zahlungsstatus": {
      "type": "string",
      "enum": [
        "Offen",
        "Bezahlt",
        "Erlassen"
      ],
      "default": "Offen"
    },
    "zahlungsdatum": {
      "type": "string",
      "format": "date"
    },
    "notizen": {
      "type": "string"
    }
  },
  "required": [
    "veranstaltung_id",
    "mitglied_id",
    "betrag"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        },
        {
          "user_condition": {
            "role": "stellv_vorstand"
          }
        },
        {
          "user_condition": {
            "role": "kassierer"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        },
        {
          "user_condition": {
            "role": "stellv_vorstand"
          }
        },
        {
          "user_condition": {
            "role": "kassierer"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        },
        {
          "user_condition": {
            "role": "stellv_vorstand"
          }
        },
        {
          "user_condition": {
            "role": "kassierer"
          }
        }
      ]
    }
  }
}