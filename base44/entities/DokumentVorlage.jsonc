{
  "name": "DokumentVorlage",
  "type": "object",
  "properties": {
    "titel": {
      "type": "string",
      "description": "Name der Vorlage"
    },
    "typ": {
      "type": "string",
      "enum": [
        "Einkaufsliste",
        "Checkliste",
        "Notiz",
        "Nachbericht",
        "Sonstiges"
      ],
      "default": "Checkliste"
    },
    "inhalt": {
      "type": "string",
      "description": "Vorlagen-Inhalt (Freitext)"
    },
    "beschreibung": {
      "type": "string",
      "description": "Kurzbeschreibung wof\u00fcr die Vorlage gedacht ist"
    }
  },
  "description": {
    "type": "string",
    "description": "Zus\u00e4tzliche Beschreibung (bis 1000 Zeichen)",
    "maxLength": 1000
  },
  "required": [
    "titel"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        },
        {
          "user_condition": {
            "role": "stellv_vorstand"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        },
        {
          "user_condition": {
            "role": "stellv_vorstand"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        },
        {
          "user_condition": {
            "role": "stellv_vorstand"
          }
        }
      ]
    }
  }
}