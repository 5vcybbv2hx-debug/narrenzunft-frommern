{
  "name": "ErstLoginProtokoll",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Base44-User-ID des Logins"
    },
    "login_email": {
      "type": "string",
      "description": "E-Mail-Adresse bei diesem Login"
    },
    "mitglied_id": {
      "type": "string",
      "description": "Verkn\u00fcpftes Mitgliedsprofil (leer, falls keines gefunden)"
    },
    "mitgliedsname": {
      "type": "string",
      "description": "Vor- und Nachname des Mitglieds (Anzeige)"
    },
    "verknuepft": {
      "type": "boolean",
      "description": "true, wenn ein Profil eindeutig verkn\u00fcpft werden konnte"
    },
    "problem": {
      "type": "string",
      "description": "Fehlergrund bei gescheiterter Verkn\u00fcpfung"
    }
  },
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}