{
  "name": "ExternePerson",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Vollst\u00e4ndiger Name"
    },
    "organisation": {
      "type": "string",
      "description": "Verein, Firma oder Organisation (optional)"
    },
    "email": {
      "type": "string",
      "description": "E-Mail-Adresse"
    },
    "telefon": {
      "type": "string",
      "description": "Telefonnummer"
    },
    "adresse": {
      "type": "string",
      "description": "Stra\u00dfe, PLZ, Ort"
    },
    "notizen": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        }
      ]
    }
  }
}