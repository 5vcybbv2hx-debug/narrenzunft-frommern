{
  "name": "ExternerVerein",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name des Vereins/der Zunft"
    },
    "stadt": {
      "type": "string",
      "description": "Stadt/Ort des Vereins"
    },
    "telefon": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "kontaktperson": {
      "type": "string",
      "description": "Name des Ansprechpartners"
    },
    "website": {
      "type": "string"
    },
    "notizen": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        },
        {
          "user_condition": {
            "role": "stellv_vorstand"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        },
        {
          "user_condition": {
            "role": "stellv_vorstand"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        },
        {
          "user_condition": {
            "role": "stellv_vorstand"
          }
        }
      ]
    }
  }
}