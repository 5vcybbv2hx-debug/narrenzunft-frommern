{
  "name": "HaesHistorie",
  "type": "object",
  "properties": {
    "haes_id": {
      "type": "string"
    },
    "mitglied_id": {
      "type": "string"
    },
    "von_datum": {
      "type": "string",
      "format": "date"
    },
    "bis_datum": {
      "type": "string",
      "format": "date"
    },
    "aktiv": {
      "type": "boolean",
      "default": true,
      "description": "Ob diese H\u00e4s-Zuweisung aktuell aktiv ist"
    },
    "notizen": {
      "type": "string"
    }
  },
  "required": [
    "haes_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        },
        {
          "user_condition": {
            "role": "spartenleiter"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        },
        {
          "user_condition": {
            "role": "spartenleiter"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        }
      ]
    }
  }
}