{
  "name": "Haesgruppe",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "beschreibung": {
      "type": "string"
    },
    "farbe": {
      "type": "string"
    },
    "typ": {
      "type": "string",
      "enum": [
        "H\u00e4sgruppe",
        "Tanzgruppe",
        "Sonstige"
      ],
      "default": "H\u00e4sgruppe",
      "description": "Art der Gruppe/Sparte"
    },
    "aktiv": {
      "type": "boolean",
      "default": true
    },
    "verantwortlicher_id": {
      "type": "string",
      "description": "Legacy \u2013 prim\u00e4re Verantwortliche Person (Spartenleiter)"
    },
    "verantwortliche_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs aller verantwortlichen Mitglieder (Spartenleiter)"
    },
    "whatsapp_gruppe_name": {
      "type": "string",
      "description": "Name der verkn\u00fcpften WhatsApp-Gruppe"
    },
    "ordnung": {
      "type": "string",
      "description": "H\u00e4sordnung: JSON-Array der mitglied_ids in Reihenfolge (f\u00fcr Aufstellung & Umzug)"
    },
    "eltern_info": {
      "type": "string",
      "description": "Eltern-Infoseite: freier Text mit Informationen f\u00fcr Eltern/Interessierte"
    },
    "kosten_info": {
      "type": "string",
      "description": "Kosten\u00fcbersicht f\u00fcr Eltern/Interessierte (freier Text)"
    },
    "empfehlungen": {
      "type": "string",
      "description": "Ausstattungs-Empfehlungen: JSON-Array (z. B. [{label, beschreibung}])"
    },
    "marktplatz_aktiv": {
      "type": "boolean",
      "default": false,
      "description": "true = Gruppen-Marktplatz ist f\u00fcr Mitglieder sichtbar"
    }
  },
  "description": {
    "type": "string",
    "description": "Zus\u00e4tzliche Beschreibung (bis 1000 Zeichen)",
    "maxLength": 1000
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        },
        {
          "user_condition": {
            "role": "stellv_vorstand"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        },
        {
          "user_condition": {
            "role": "stellv_vorstand"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        }
      ]
    }
  }
}