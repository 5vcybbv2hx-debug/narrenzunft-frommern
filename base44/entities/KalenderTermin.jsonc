{
  "name": "KalenderTermin",
  "type": "object",
  "properties": {
    "titel": {
      "type": "string"
    },
    "beschreibung": {
      "type": "string"
    },
    "datum": {
      "type": "string",
      "format": "date"
    },
    "startzeit": {
      "type": "string",
      "description": "HH:MM"
    },
    "endzeit": {
      "type": "string",
      "description": "HH:MM"
    },
    "ort": {
      "type": "string"
    },
    "terminart": {
      "type": "string",
      "enum": [
        "Umzug",
        "Abendveranstaltung",
        "Arbeitsdienst",
        "Ausschusssitzung",
        "Vorstandssitzung",
        "Jugendtermin",
        "Gruppen-Termin",
        "Intern",
        "Sonstiges"
      ],
      "default": "Intern"
    },
    "sichtbarkeit": {
      "type": "string",
      "enum": [
        "alle",
        "admin",
        "ausschuss",
        "verantwortliche",
        "haesgruppe",
        "eingeladen"
      ],
      "default": "alle"
    },
    "zielgruppe_rollen": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "haesgruppe_id": {
      "type": "string"
    },
    "verantwortliche_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "eingeladene_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "abonnierbar": {
      "type": "boolean",
      "default": true
    },
    "anmeldbar": {
      "type": "boolean",
      "default": false
    },
    "anmeldeschluss": {
      "type": "string",
      "format": "date"
    },
    "max_teilnehmer": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "Geplant",
        "Aktiv",
        "Abgeschlossen",
        "Abgesagt"
      ],
      "default": "Geplant"
    },
    "veranstaltung_id": {
      "type": "string",
      "description": "Verkn\u00fcpfte Veranstaltungs-ID (f\u00fcr automatische Sync)"
    },
    "sitzungs_status": {
      "type": "string",
      "enum": [
        "Entwurf",
        "Eingeladen",
        "L\u00e4uft",
        "Nachbereitung",
        "Abgeschlossen",
        "Abgesagt"
      ],
      "default": "Entwurf",
      "description": "Lifecycle-Phase einer Ausschusssitzung"
    },
    "top_einreichungsfrist": {
      "type": "string",
      "format": "date",
      "description": "Frist f\u00fcr die TOP-Einreichung"
    },
    "einladung_gesendet_am": {
      "type": "string",
      "format": "date-time",
      "description": "Wann wurde die Einladung/Tagesordnung versendet"
    },
    "tops_gesperrt": {
      "type": "boolean",
      "default": false,
      "description": "Agenda ist gesperrt (keine TOP-\u00c4nderungen mehr)"
    },
    "protokoll_status": {
      "type": "string",
      "enum": [
        "Ausstehend",
        "Entwurf",
        "In Pr\u00fcfung",
        "Freigegeben",
        "Ver\u00f6ffentlicht"
      ],
      "default": "Ausstehend"
    },
    "dateien": {
      "type": "array",
      "description": "Anh\u00e4nge (Metadaten, keine eigene Dokument-Entit\u00e4t)",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "typ": {
            "type": "string"
          },
          "groesse": {
            "type": "number"
          },
          "datum": {
            "type": "string",
            "format": "date-time"
          },
          "hochgeladen_von_id": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "titel",
    "datum",
    "terminart"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        },
        {
          "user_condition": {
            "role": "spartenleiter"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        },
        {
          "user_condition": {
            "role": "spartenleiter"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        }
      ]
    }
  }
}