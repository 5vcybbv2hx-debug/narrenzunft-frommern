{
  "name": "MarktplatzAngebot",
  "type": "object",
  "properties": {
    "haesgruppe_id": {
      "type": "string",
      "description": "ID der Gruppe, deren Marktplatz dieses Angebot geh\u00f6rt"
    },
    "mitglied_id": {
      "type": "string",
      "description": "ID des anbietenden Mitglieds"
    },
    "mitglied_name": {
      "type": "string",
      "description": "Name des anbietenden Mitglieds (denormalisiert)"
    },
    "titel": {
      "type": "string",
      "description": "Titel des Angebots"
    },
    "beschreibung": {
      "type": "string",
      "description": "Beschreibung / Zustand"
    },
    "preis": {
      "type": "string",
      "description": "Preis in Euro (leer = VB/geschenkt)"
    },
    "status": {
      "type": "string",
      "enum": [
        "Aktiv",
        "Verkauft",
        "Entfernt"
      ],
      "default": "Aktiv",
      "description": "Status des Angebots"
    }
  },
  "description": {
    "type": "string",
    "description": "Zus\u00e4tzliche Beschreibung (bis 1000 Zeichen)",
    "maxLength": 1000
  },
  "required": [
    "haesgruppe_id",
    "mitglied_id",
    "titel"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        },
        {
          "user_condition": {
            "role": "stellv_vorstand"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        },
        {
          "user_condition": {
            "role": "stellv_vorstand"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        },
        {
          "user_condition": {
            "role": "stellv_vorstand"
          }
        }
      ]
    }
  }
}