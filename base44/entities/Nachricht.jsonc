{
  "name": "Nachricht",
  "type": "object",
  "properties": {
    "absender_mitglied_id": {
      "type": "string",
      "description": "ID des absendenden Mitglieds"
    },
    "empfaenger_mitglied_id": {
      "type": "string",
      "description": "ID des empfangenden Mitglieds (Funktion\u00e4r/Vorstand)"
    },
    "betreff": {
      "type": "string",
      "description": "Betreffzeile"
    },
    "inhalt": {
      "type": "string",
      "description": "Nachrichtentext"
    },
    "gelesen": {
      "type": "boolean",
      "default": false,
      "description": "Wurde die Nachricht gelesen?"
    },
    "gelesen_am": {
      "type": "string",
      "format": "date",
      "description": "Wann wurde gelesen?"
    }
  },
  "required": [
    "absender_mitglied_id",
    "empfaenger_mitglied_id",
    "betreff",
    "inhalt"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        }
      ]
    }
  }
}