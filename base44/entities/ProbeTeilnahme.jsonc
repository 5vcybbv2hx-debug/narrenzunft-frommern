{
  "name": "ProbeTeilnahme",
  "type": "object",
  "properties": {
    "termin_id": {
      "type": "string",
      "description": "SpartenTermin-ID (Probe)"
    },
    "haesgruppe_id": {
      "type": "string",
      "description": "Gruppe des Termins"
    },
    "mitglied_id": {
      "type": "string",
      "description": "Teilnehmer:in"
    },
    "abgemeldet": {
      "type": "boolean",
      "description": "true = f\u00fcr diese Probe abgemeldet"
    },
    "abgemeldet_am": {
      "type": "string",
      "description": "ISO-Zeitstempel der Abmeldung"
    },
    "abgemeldet_durch_id": {
      "type": "string",
      "description": "Wer abgemeldet hat (selbst oder Elternteil)"
    },
    "abgemeldet_verspaetet": {
      "type": "boolean",
      "default": false,
      "description": "true = Abmeldung nach dem Abmelde-Schluss der Gruppe"
    },
    "grund": {
      "type": "string",
      "description": "Optionaler Grund"
    },
    "anwesend": {
      "type": "boolean",
      "description": "Von Verantwortlichen erfasste Anwesenheit"
    },
    "anwesend_gesetzt_von": {
      "type": "string",
      "description": "Mitglied-ID der erfassenden Person"
    },
    "anwesend_gesetzt_am": {
      "type": "string",
      "description": "ISO-Zeitstempel der Erfassung"
    }
  },
  "rls": {
    "read": null,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}