{
  "name": "Protokoll",
  "type": "object",
  "properties": {
    "termin_id": {
      "type": "string",
      "description": "ID der verkn\u00fcpften Sitzung (KalenderTermin)"
    },
    "titel": {
      "type": "string"
    },
    "inhalt": {
      "type": "string",
      "description": "Freitext-Protokollinhalt"
    },
    "datei_url": {
      "type": "string",
      "description": "URL einer hochgeladenen Protokolldatei (Legacy)"
    },
    "datei_name": {
      "type": "string",
      "description": "Dateiname der hochgeladenen Datei (Legacy)"
    },
    "autor_mitglied_id": {
      "type": "string",
      "description": "ID des Verfassers"
    },
    "datum": {
      "type": "string",
      "format": "date"
    },
    "veroeffentlicht": {
      "type": "boolean",
      "default": false,
      "description": "Legacy-Feld; wird r\u00fcckw\u00e4rtskompatibel weitergef\u00fchrt (entspricht Freigegeben/Ver\u00f6ffentlicht)"
    },
    "freigabestatus": {
      "type": "string",
      "enum": [
        "Entwurf",
        "In Pr\u00fcfung",
        "Freigegeben",
        "Ver\u00f6ffentlicht"
      ],
      "default": "Entwurf"
    },
    "freigegeben_am": {
      "type": "string",
      "format": "date-time"
    },
    "dateien": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "typ": {
            "type": "string"
          },
          "groesse": {
            "type": "number"
          },
          "datum": {
            "type": "string",
            "format": "date-time"
          },
          "hochgeladen_von_id": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "titel",
    "datum"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        },
        {
          "user_condition": {
            "role": "stellv_vorstand"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}