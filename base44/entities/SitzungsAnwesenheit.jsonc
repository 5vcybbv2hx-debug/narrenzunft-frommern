{
  "name": "SitzungsAnwesenheit",
  "type": "object",
  "properties": {
    "termin_id": {
      "type": "string"
    },
    "mitglied_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Anwesend",
        "Entschuldigt",
        "Unentschuldigt"
      ],
      "default": "Anwesend"
    }
  },
  "description": {
    "type": "string",
    "description": "Zus\u00e4tzliche Beschreibung (bis 1000 Zeichen)",
    "maxLength": 1000
  },
  "required": [
    "termin_id",
    "mitglied_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        },
        {
          "user_condition": {
            "role": "stellv_vorstand"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        },
        {
          "user_condition": {
            "role": "stellv_vorstand"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        }
      ]
    }
  }
}