{
  "name": "SpartenTermin",
  "type": "object",
  "properties": {
    "haesgruppe_id": {
      "type": "string",
      "description": "ID der Gruppe/Sparte"
    },
    "titel": {
      "type": "string"
    },
    "typ": {
      "type": "string",
      "enum": [
        "Probe",
        "Auftritt",
        "Besprechung",
        "Ausflug",
        "Training",
        "Sonstiges"
      ],
      "default": "Probe"
    },
    "datum": {
      "type": "string",
      "format": "date"
    },
    "uhrzeit": {
      "type": "string",
      "description": "HH:MM"
    },
    "endzeit": {
      "type": "string",
      "description": "HH:MM"
    },
    "ort": {
      "type": "string"
    },
    "beschreibung": {
      "type": "string"
    },
    "wiederkehrend": {
      "type": "boolean",
      "default": false,
      "description": "Ist dies ein wiederkehrender Termin?"
    },
    "intervall_typ": {
      "type": "string",
      "enum": [
        "woechentlich",
        "14taegig",
        "monatlich"
      ],
      "description": "Wiederholungsintervall (nur wenn wiederkehrend=true)"
    },
    "enddatum": {
      "type": "string",
      "format": "date",
      "description": "Enddatum der Wiederholung (nur wenn wiederkehrend=true)"
    }
  },
  "required": [
    "haesgruppe_id",
    "titel",
    "datum"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        },
        {
          "user_condition": {
            "role": "spartenleiter"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        },
        {
          "user_condition": {
            "role": "spartenleiter"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        },
        {
          "user_condition": {
            "role": "spartenleiter"
          }
        }
      ]
    }
  }
}