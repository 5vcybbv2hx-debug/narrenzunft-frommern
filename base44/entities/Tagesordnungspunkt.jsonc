{
  "name": "Tagesordnungspunkt",
  "type": "object",
  "properties": {
    "termin_id": {
      "type": "string",
      "description": "ID des KalenderTermins (Sitzung)"
    },
    "reihenfolge": {
      "type": "number",
      "default": 1
    },
    "titel": {
      "type": "string"
    },
    "beschreibung": {
      "type": "string"
    },
    "notizen": {
      "type": "string",
      "description": "Ergebnis / Protokollnotiz"
    },
    "status": {
      "type": "string",
      "enum": [
        "Offen",
        "Besprochen",
        "Vertagt"
      ],
      "default": "Offen"
    },
    "verantwortlicher_id": {
      "type": "string"
    }
  },
  "required": [
    "termin_id",
    "titel"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        },
        {
          "user_condition": {
            "role": "stellv_vorstand"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        },
        {
          "user_condition": {
            "role": "stellv_vorstand"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        }
      ]
    }
  }
}