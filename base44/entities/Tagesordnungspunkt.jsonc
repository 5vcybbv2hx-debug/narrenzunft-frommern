{
  "name": "Tagesordnungspunkt",
  "type": "object",
  "properties": {
    "termin_id": {
      "type": "string",
      "description": "ID des KalenderTermins (Sitzung)"
    },
    "reihenfolge": {
      "type": "number",
      "default": 1
    },
    "titel": {
      "type": "string"
    },
    "beschreibung": {
      "type": "string"
    },
    "notizen": {
      "type": "string",
      "description": "Ergebnis / Protokollnotiz"
    },
    "status": {
      "type": "string",
      "enum": [
        "Offen",
        "Besprochen",
        "Vertagt"
      ],
      "default": "Offen"
    },
    "verantwortlicher_id": {
      "type": "string"
    },
    "veranstaltung_id": {
      "type": "string",
      "description": "ID der verkn\u00fcpften Veranstaltung (optional, f\u00fcr Veranstaltungs-TOPs)"
    },
    "quell_aufgabe_id": {
      "type": "string",
      "description": "ID der Ausschussaufgabe, aus der dieser TOP hervorgegangen ist (Aufgabe wird NICHT gel\u00f6scht)"
    },
    "beantragt_von_id": {
      "type": "string",
      "description": "Mitglied, das den TOP eingereicht hat"
    },
    "kategorie": {
      "type": "string",
      "description": "Freie Kategorie/Themenbereich"
    },
    "dauer_minuten": {
      "type": "number",
      "default": 15,
      "description": "Geplantes Zeitbudget f\u00fcr diesen TOP"
    },
    "vertraulich": {
      "type": "boolean",
      "default": false
    },
    "abstimmung_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs der aus diesem TOP erzeugten Abstimmungen"
    },
    "beschluss_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs der aus diesem TOP gefassten Beschl\u00fcsse"
    },
    "aufgabe_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs der aus diesem TOP entstandenen Aufgaben"
    },
    "dateien": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "typ": {
            "type": "string"
          },
          "groesse": {
            "type": "number"
          },
          "datum": {
            "type": "string",
            "format": "date-time"
          },
          "hochgeladen_von_id": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "termin_id",
    "titel"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        },
        {
          "user_condition": {
            "role": "stellv_vorstand"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        },
        {
          "user_condition": {
            "role": "stellv_vorstand"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        }
      ]
    }
  }
}