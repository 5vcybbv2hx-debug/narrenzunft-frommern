{
  "name": "Teilnahme",
  "type": "object",
  "properties": {
    "veranstaltung_id": {
      "type": "string"
    },
    "mitglied_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Angemeldet",
        "Abgesagt",
        "Best\u00e4tigt",
        "Anwesend",
        "Abwesend"
      ],
      "default": "Angemeldet"
    },
    "bus": {
      "type": "boolean",
      "default": false
    },
    "bus_anwesend": {
      "type": "boolean",
      "default": false
    },
    "notizen": {
      "type": "string"
    }
  },
  "required": [
    "veranstaltung_id",
    "mitglied_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        },
        {
          "user_condition": {
            "role": "spartenleiter"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        },
        {
          "user_condition": {
            "role": "spartenleiter"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        }
      ]
    }
  }
}