{
  "name": "Todo",
  "type": "object",
  "properties": {
    "titel": {
      "type": "string",
      "description": "Titel der Aufgabe"
    },
    "beschreibung": {
      "type": "string",
      "description": "Detailbeschreibung"
    },
    "status": {
      "type": "string",
      "enum": [
        "Offen",
        "In Bearbeitung",
        "Erledigt"
      ],
      "default": "Offen"
    },
    "prioritaet": {
      "type": "string",
      "enum": [
        "Niedrig",
        "Mittel",
        "Hoch",
        "Dringend"
      ],
      "default": "Mittel"
    },
    "faellig_am": {
      "type": "string",
      "format": "date"
    },
    "ersteller_mitglied_id": {
      "type": "string",
      "description": "Mitglied das die Aufgabe erstellt hat"
    },
    "verantwortliche_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs der verantwortlichen Mitglieder (mind. 1 erforderlich)"
    },
    "notizen": {
      "type": "string"
    }
  },
  "required": [
    "titel",
    "verantwortliche_ids"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        }
      ]
    }
  }
}