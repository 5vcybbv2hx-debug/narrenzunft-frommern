{
  "name": "VeranstaltungBereich",
  "type": "object",
  "properties": {
    "veranstaltung_id": {
      "type": "string",
      "description": "ID der verkn\u00fcpften Veranstaltung"
    },
    "vorlage_id": {
      "type": "string",
      "description": "ID der Vorlage, aus der dieser Bereich generiert wurde (optional)"
    },
    "name": {
      "type": "string",
      "description": "Bezeichnung des Bereichs"
    },
    "verantwortlicher_id": {
      "type": "string",
      "description": "ID des verantwortlichen Mitglieds"
    },
    "verantwortlicher_name": {
      "type": "string",
      "description": "Name des Verantwortlichen (denormalisiert)"
    },
    "status": {
      "type": "string",
      "enum": [
        "Offen",
        "In Planung",
        "Erledigt"
      ],
      "default": "Offen"
    },
    "notizen": {
      "type": "string",
      "description": "Vorab-Notizen / Planungshinweise"
    },
    "nachher_notizen": {
      "type": "string",
      "description": "Notizen zur Nachbereitung / R\u00fcckschau"
    },
    "liste": {
      "type": "string",
      "description": "JSON-Array der Positionen in diesem Bereich"
    },
    "sortierung": {
      "type": "number",
      "default": 0,
      "description": "Reihenfolge der Bereiche"
    }
  },
  "required": [
    "veranstaltung_id",
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        },
        {
          "user_condition": {
            "role": "stellv_vorstand"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        },
        {
          "user_condition": {
            "role": "stellv_vorstand"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        }
      ]
    }
  }
}