{
  "name": "VeranstaltungsDokument",
  "type": "object",
  "properties": {
    "veranstaltung_id": {
      "type": "string",
      "description": "ID der verkn\u00fcpften Veranstaltung"
    },
    "titel": {
      "type": "string"
    },
    "typ": {
      "type": "string",
      "enum": [
        "Einkaufsliste",
        "Checkliste",
        "Notiz",
        "Nachbericht",
        "Sonstiges"
      ],
      "default": "Notiz"
    },
    "inhalt": {
      "type": "string",
      "description": "Freitext-Inhalt (Notizen, Listen etc.)"
    },
    "datei_url": {
      "type": "string",
      "description": "URL einer hochgeladenen Datei"
    },
    "datei_name": {
      "type": "string",
      "description": "Dateiname f\u00fcr die Anzeige"
    }
  },
  "required": [
    "veranstaltung_id",
    "titel"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        },
        {
          "user_condition": {
            "role": "stellv_vorstand"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        },
        {
          "user_condition": {
            "role": "stellv_vorstand"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        }
      ]
    }
  }
}