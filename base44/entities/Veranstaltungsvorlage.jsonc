{
  "name": "Veranstaltungsvorlage",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name der Vorlage"
    },
    "typ": {
      "type": "string",
      "enum": [
        "Umzug",
        "Abendveranstaltung",
        "Intern",
        "Arbeitsdienst",
        "Fest"
      ],
      "default": "Intern"
    },
    "ort": {
      "type": "string"
    },
    "uhrzeit": {
      "type": "string"
    },
    "beschreibung": {
      "type": "string"
    },
    "bus_erforderlich": {
      "type": "boolean",
      "default": false
    },
    "anmeldung_aktiv": {
      "type": "boolean",
      "default": true
    },
    "busparkplatz_adresse": {
      "type": "string"
    },
    "busparkplatz_treffzeit": {
      "type": "string"
    },
    "hinweise": {
      "type": "string"
    },
    "arbeitsdienst_vorlagen": {
      "type": "array",
      "description": "Vordefinierte Arbeitsdienste, die automatisch angelegt werden",
      "items": {
        "type": "object",
        "properties": {
          "titel": {
            "type": "string"
          },
          "beschreibung": {
            "type": "string"
          },
          "benoetigte_personen": {
            "type": "number"
          }
        }
      }
    },
    "bereich_vorlagen": {
      "type": "string",
      "description": "JSON-Array der vordefinierten Bereiche f\u00fcr diese Vorlage"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        },
        {
          "user_condition": {
            "role": "stellv_vorstand"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        },
        {
          "user_condition": {
            "role": "stellv_vorstand"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        }
      ]
    }
  }
}