{
  "name": "VereinKontakt",
  "type": "object",
  "properties": {
    "verein_id": {
      "type": "string",
      "description": "ID des Vereins"
    },
    "name": {
      "type": "string",
      "description": "Name der Kontaktperson"
    },
    "email": {
      "type": "string"
    },
    "telefon": {
      "type": "string"
    },
    "funktion": {
      "type": "string",
      "description": "Position/Funktion (z.B. Vorsitzender, Organisator)"
    },
    "notizen": {
      "type": "string"
    }
  },
  "required": [
    "verein_id",
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        },
        {
          "user_condition": {
            "role": "stellv_vorstand"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        },
        {
          "user_condition": {
            "role": "stellv_vorstand"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        }
      ]
    }
  }
}