{
  "name": "Verwandtschaft",
  "type": "object",
  "properties": {
    "mitglied_id": {
      "type": "string",
      "description": "Das Mitglied, von dem aus die Beziehung definiert wird"
    },
    "verwandter_id": {
      "type": "string",
      "description": "Das verwandte Mitglied"
    },
    "beziehung": {
      "type": "string",
      "enum": [
        "Elternteil",
        "Kind",
        "Geschwister",
        "Gro\u00dfelternteil",
        "Enkel",
        "Onkel/Tante",
        "Nichte/Neffe",
        "Ehepartner/in",
        "Sonstige"
      ],
      "description": "Art der Verwandtschaft von mitglied_id aus gesehen"
    },
    "notizen": {
      "type": "string",
      "description": "Optionale Anmerkung zur Beziehung"
    }
  },
  "required": [
    "mitglied_id",
    "verwandter_id",
    "beziehung"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vorstand"
          }
        }
      ]
    }
  }
}